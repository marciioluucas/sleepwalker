#!/bin/bash
# sleepwalker daemon — runs as root every 10s (launchd).
# @HOME@ and @UID@ are filled in by `swk setup`. Settings are read on every run
# from the user's config file and validated; nothing from it is ever executed.
#
# Stay awake (even with the lid closed) while the agent is present and:
#   working (hooks) or active in the last idle_min minutes (hooks or CPU), and
#   on AC — or on battery with battery=on, above battery_min %, online
#   (offline_grace minutes of tolerance to hop to a hotspot).
# With an external display attached sleepwalker stays out of the way: macOS
# already keeps a closed Mac on a monitor awake, and decides when it sleeps.
# When sleepwalker lets go and the lid is closed, it puts the Mac to sleep —
# only if it was the one holding it, and never right after a wake.

USER_HOME="@HOME@"
USER_UID="@UID@"
CONF="$USER_HOME/.config/sleepwalker/config"
THROTTLE="$USER_HOME/.config/sleepwalker/throttle.txt"
HOLDS="$USER_HOME/.local/state/sleepwalker/holds"
LAST="$USER_HOME/.local/state/sleepwalker/last-activity"
ST=/var/db/sleepwalker
/bin/mkdir -p "$ST"

# read a setting: text limited to safe characters, numbers must be numbers
cfg() {
  local v; v=$(/usr/bin/sed -n "s/^$1=//p" "$CONF" 2>/dev/null | /usr/bin/tail -1)
  [[ "$v" =~ ^[A-Za-z0-9\ ._+-]*$ ]] || v=""
  echo "${v:-$2}"
}
num() { local v; v=$(cfg "$1" "$2"); [[ "$v" =~ ^[0-9]+$ ]] && echo "$v" || echo "$2"; }

AGENT=$(cfg agent claude)
APP=$(cfg app "")
TERMINAL=$(cfg terminal "")
BATTERY=$(cfg battery off)
IDLE_MIN=$(num idle_min 30)
BATTERY_MIN=$(num battery_min 15)
OFFLINE_GRACE=$(num offline_grace 5)
CPU_THROTTLE=$(num cpu_throttle 20)
ACTIVE_CPU=$(num active_cpu 0)
LOW_POWER=$(cfg low_power on)
THROTTLE_ON=$(cfg throttle on)
THROTTLE_MODE=$(cfg throttle_mode suspend)
TEMP_MAX=$(num temp_max 45)
WAKE_GRACE=$(num wake_grace 3)
HOTSPOT=$(cfg hotspot "")
HOTSPOT_AFTER=$(num hotspot_after 1)
# virtual machines lose time and drop connections when frozen: slow them down only
NO_SUSPEND="OrbStack Docker UTM Parallels Desktop VMware Fusion VirtualBox"

now=$(/bin/date +%s)
batt=$(/usr/bin/pmset -g batt)
pct=$(echo "$batt" | /usr/bin/grep -o '[0-9]*%' | /usr/bin/head -1 | /usr/bin/tr -d %)
on_ac() { echo "$batt" | /usr/bin/grep -q "AC Power"; }
# online = the internet answers, not just "there is a route": a captive or dead
# Wi-Fi (mall, hotel, bus) has a route and still drops the remote session
internet() {
  /sbin/route -n get default >/dev/null 2>&1 &&
    /usr/bin/curl -s --max-time 4 http://captive.apple.com/hotspot-detect.html 2>/dev/null | /usr/bin/grep -q Success
}
online() {
  if internet; then /bin/rm -f "$ST/offline"; return 0; fi
  [ -f "$ST/offline" ] || /usr/bin/touch "$ST/offline"
  # no internet for a while: join your phone's hotspot (at most every 2 min)
  if [ -n "$HOTSPOT" ] && /usr/bin/find "$ST/offline" -mmin +"$HOTSPOT_AFTER" | /usr/bin/grep -q . &&
     ! /usr/bin/find "$ST/hotspot-try" -mmin -2 2>/dev/null | /usr/bin/grep -q .; then
    /usr/bin/touch "$ST/hotspot-try"
    wifi=$(/usr/sbin/networksetup -listallhardwareports | /usr/bin/awk '/Wi-Fi/{getline; print $2; exit}')
    [ -n "$wifi" ] && /usr/sbin/networksetup -setairportnetwork "$wifi" "$HOTSPOT" >/dev/null 2>&1
  fi
  ! /usr/bin/find "$ST/offline" -mmin +"$OFFLINE_GRACE" | /usr/bin/grep -q .
}
lid=0; /usr/sbin/ioreg -r -k AppleClamshellState -d 1 | /usr/bin/grep -q '"AppleClamshellState" = Yes' && lid=1
# an external display that is actually attached (its framebuffer has DisplayAttributes)
ext=0; /usr/sbin/ioreg -lw0 -r -c IOMobileFramebufferShim -d 1 2>/dev/null | /usr/bin/awk '
  /^\+-o/{n++} /"external" = Yes/{e[n]=1} /"DisplayAttributes" =/{d[n]=1}
  END{for (i in e) if (d[i]) exit 0; exit 1}' && ext=1
# battery "virtual" temperature in whole °C — the closest to what the bag feels
vtemp=$(/usr/sbin/ioreg -rn AppleSmartBattery | /usr/bin/awk -F' = ' '/"VirtualTemperature" =/{printf "%d", $2/100}')
# a phone charging from the Mac multiplies battery drain (~5x measured)
usb_phone=0; /usr/sbin/ioreg -p IOUSB -w0 2>/dev/null | /usr/bin/grep -qE 'iPhone|iPad' && usb_phone=1
waketime=$(/usr/sbin/sysctl -n kern.waketime 2>/dev/null | /usr/bin/sed -n 's/.*sec = \([0-9]*\),.*/\1/p')

# processes protected from throttling: the agent's tree (now, and anything it
# started earlier that is still alive), its parents, the configured terminal and
# desktop app, and any browser opened for automation (CDP / remote debugging)
PS=$(/bin/ps -Ao pid=,ppid=,uid=,pcpu=,comm=)
ROOTS=$( { /bin/cat "$ST/tree-pids" 2>/dev/null
           /bin/ps -Ao pid=,args= | /usr/bin/awk '/--remote-debugging-p(ort|ipe)/{print $1}'; } | /usr/bin/tr '\n' ' ')
SCAN=$(echo "$PS" | /usr/bin/awk -v agent="$AGENT" -v app="$APP" -v term="$TERMINAL" -v uid="$USER_UID" -v lim="$CPU_THROTTLE" -v roots="$ROOTS" '
  { pid[NR]=$1; pp[$1]=$2; u[$1]=$3; cpu[$1]=$4; c=$5; for(i=6;i<=NF;i++) c=c" "$i; cmd[$1]=c; kids[$2]=kids[$2]" "$1 }
  function inapp(p, name) { return name != "" && index(cmd[p], "/Applications/" name ".app/") > 0 }
  END {
    for (k=1; k<=NR; k++) {
      p=pid[k]; n=cmd[p]; sub(/.*\//,"",n)
      if (n==agent || inapp(p, app)) { present=1; q[++t]=p; for (a=pp[p]; a>1; a=pp[a]) keep[a]=1 }
      if (inapp(p, term)) keep[p]=1
    }
    m=split(roots, r, " "); for (j=1;j<=m;j++) if ((r[j] in pp) && u[r[j]]==uid) q[++t]=r[j]
    while (h<t) { p=q[++h]; if (!(p in tree)) { tree[p]=1; keep[p]=1; m=split(kids[p], ch, " "); for (j=1;j<=m;j++) q[++t]=ch[j] } }
    for (p in tree) { busy+=cpu[p]; print "tree", p }
    for (p in keep) print "keep", p
    printf "present=%d busy=%d\n", present, busy
    for (k=1; k<=NR; k++) { p=pid[k]; if (u[p]==uid && cpu[p]+0>=lim && !keep[p] && cmd[p] !~ /^\/(System|usr\/libexec|usr\/sbin)\//) print "slow", p }
  }')
present=$(echo "$SCAN" | /usr/bin/sed -n 's/^present=\([0-9]*\).*/\1/p')
busy=$(echo "$SCAN" | /usr/bin/sed -n 's/.*busy=\([0-9]*\).*/\1/p')
echo "$SCAN" | /usr/bin/awk '$1=="tree"{print $2}' > "$ST/tree-pids"
kept() { echo "$SCAN" | /usr/bin/grep -qx "keep $1"; }

# activity: hooks (hold/release) or the agent itself burning CPU (agents without hooks)
[ "$ACTIVE_CPU" -gt 0 ] && [ "${busy:-0}" -ge "$ACTIVE_CPU" ] && /usr/bin/touch "$ST/cpu-activity"
work=0; /usr/bin/find "$HOLDS" -type f -mmin -360 2>/dev/null | /usr/bin/grep -q . && work=1
recent() { /usr/bin/find "$LAST" "$ST/cpu-activity" -mmin -"$IDLE_MIN" 2>/dev/null | /usr/bin/grep -q .; }

want=0; why=idle
if [ "$ext" = 1 ]; then
  why=display
elif [ "$present" != 1 ]; then
  why=no-agent
elif [ "$work" = 1 ] || recent; then
  if on_ac; then want=1; why=ac; online || true   # still hops to the hotspot (car charger)
  elif [ "$BATTERY" != on ]; then why=battery-mode-off
  elif [ "${pct:-0}" -le "$BATTERY_MIN" ]; then why=low-battery
  elif ! online; then why=offline
  else want=1; why=battery
  fi
fi
# heat guards (think: closed Mac in a backpack)
if /usr/bin/pmset -g therm | /usr/bin/grep -qiE 'thermal warning level.*[1-9]'; then want=0; why=thermal; fi
if [ "$TEMP_MAX" -gt 0 ] && [ "${vtemp:-0}" -ge "$TEMP_MAX" ]; then want=0; why=hot; fi

cur=$(/usr/bin/pmset -g | /usr/bin/awk '/SleepDisabled/{print $2}')
[ "$cur" != "$want" ] && /usr/bin/pmset -a disablesleep "$want"

# keep only pids that are still alive and still the user's (pid reuse)
prune() {
  [ -f "$1" ] || return 0
  /usr/bin/sort -u "$1" | while read -r pid; do
    [ "$(/bin/ps -o uid= -p "$pid" 2>/dev/null | /usr/bin/tr -d ' ')" = "$USER_UID" ] && echo "$pid"
  done > "$1.tmp"
  /bin/mv "$1.tmp" "$1"; [ -s "$1" ] || /bin/rm -f "$1"
}
thaw()   { prune "$ST/stopped"; [ -f "$ST/stopped" ] || return 0; while read -r pid; do /bin/kill -CONT "$pid" 2>/dev/null; done < "$ST/stopped"; /bin/rm -f "$ST/stopped"; }
unslow() { prune "$ST/pids"; [ -f "$ST/pids" ] || return 0; while read -r pid; do /usr/sbin/taskpolicy -B -p "$pid" 2>/dev/null; done < "$ST/pids"; /bin/rm -f "$ST/pids"; }
slow()   { /usr/sbin/taskpolicy -b -p "$1" 2>/dev/null && echo "$1" >> "$ST/pids"; }

# Awake on battery = save power: Low Power Mode; apps in the throttle list frozen
# (lid closed, agent between turns) or at background priority; other heavy
# processes slowed down. Leaving this state undoes only what sleepwalker did.
lpm_now=$(/usr/bin/pmset -g | /usr/bin/awk '/lowpowermode/{print $2}')
if [ "$want" = 1 ] && ! on_ac; then
  # the user turned Low Power Mode off by hand: respect it until this state ends
  if [ -f "$ST/lpm" ] && [ "$lpm_now" != 1 ]; then /bin/rm -f "$ST/lpm"; /usr/bin/touch "$ST/lpm-user-off"; fi
  if [ "$LOW_POWER" = on ] && [ "$lpm_now" != 1 ] && [ ! -f "$ST/lpm-user-off" ]; then
    /usr/bin/pmset -a lowpowermode 1 && /usr/bin/touch "$ST/lpm"
  fi
  # freezing only with nobody at the keyboard and the agent between turns
  freeze=0; [ "$THROTTLE_ON" = on ] && [ "$THROTTLE_MODE" = suspend ] && [ "$lid" = 1 ] && [ "$work" = 0 ] && freeze=1
  [ "$freeze" = 0 ] && thaw
  if [ "$THROTTLE_ON" = on ] && [ -f "$THROTTLE" ]; then
    while IFS= read -r a; do
      case "$a" in ''|\#*) continue ;; esac
      [[ "$a" =~ ^[A-Za-z0-9\ ._+-]+$ ]] || continue
      [ "$a" = "$TERMINAL" ] || [ "$a" = "$APP" ] && continue
      pids=$(/usr/bin/pgrep -U "$USER_UID" -f "/Applications/$a.app/")
      [ -n "$pids" ] || continue
      # all or nothing per app: a half-frozen app is worse than either state
      prot=0; for pid in $pids; do kept "$pid" && { prot=1; break; }; done
      [ "$prot" = 1 ] && continue
      if [ "$freeze" = 1 ] && ! echo " $NO_SUSPEND " | /usr/bin/grep -qF " $a "; then
        for pid in $pids; do /bin/kill -STOP "$pid" 2>/dev/null && echo "$pid" >> "$ST/stopped"; done
      else
        for pid in $pids; do slow "$pid"; done
      fi
    done < "$THROTTLE"
  fi
  if [ "$THROTTLE_ON" = on ]; then for pid in $(echo "$SCAN" | /usr/bin/awk '$1=="slow"{print $2}'); do slow "$pid"; done; else unslow; fi
  prune "$ST/pids"; prune "$ST/stopped"
  # `swk hook start` thaws right away (no root needed: the pids are the user's)
  [ -f "$ST/stopped" ] && /bin/chmod 644 "$ST/stopped"
else
  if [ -f "$ST/lpm" ]; then /usr/bin/pmset -a lowpowermode 0; /bin/rm -f "$ST/lpm"; fi
  /bin/rm -f "$ST/lpm-user-off"
  thaw; unslow
fi

slowed=0; [ -f "$ST/pids" ] && slowed=$(/usr/bin/wc -l < "$ST/pids" | /usr/bin/tr -d ' ')
frozen=0; [ -f "$ST/stopped" ] && frozen=$(/usr/bin/wc -l < "$ST/stopped" | /usr/bin/tr -d ' ')

# status snapshot for `swk status` (readable by the user)
printf 'present=%s busy=%s want=%s why=%s lid=%s display=%s temp=%s usb_phone=%s slowed=%s frozen=%s at=%s\n' \
  "${present:-0}" "${busy:-0}" "$want" "$why" "$lid" "$ext" "${vtemp:-0}" "$usb_phone" "$slowed" "$frozen" "$now" > "$ST/state"
/bin/chmod 644 "$ST/state"

# Put a closed Mac to sleep when sleepwalker lets go of it — only if it was the
# one holding it (never second-guess macOS otherwise), not on an external
# display, and not within wake_grace minutes of a wake (a message from your
# phone may have just woken it; give the agent's hook time to hold it).
if [ "$want" = 1 ]; then
  /usr/bin/touch "$ST/held"
elif [ -f "$ST/held" ]; then
  if [ "$lid" = 0 ] || [ "$ext" = 1 ]; then
    /bin/rm -f "$ST/held"
  elif [ $(( now - ${waketime:-0} )) -ge $(( WAKE_GRACE * 60 )) ]; then
    /bin/rm -f "$ST/held"; /usr/bin/pmset sleepnow
  fi
fi
